# Required
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_ALLOWED_USERS=123456789

# Auth — PIN for onboarding new users via /auth <PIN>
AUTH_PIN=change-me-to-a-secure-pin
AUTH_DATA_DIR=.data

# OpenCode Server
OPENCODE_API_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=
OPENCODE_DEFAULT_DIR=/home/you/projects

# Model pinned onto fresh (history-less) sessions, which would otherwise
# inherit a global default that may stall without credentials.
OPENCODE_DEFAULT_MODEL=opencode/muse-spark-1.3-contributor-free

# Optional
OPENCODE_AUTO_START=true
OPENCODE_BIN_PATH=
LOG_LEVEL=info
STREAM_THROTTLE_MS=800
MAX_MESSAGE_LENGTH=4000

# Voice notes (local faster-whisper, fully offline).
# Python must have faster-whisper installed (a venv is recommended):
#   python3 -m venv .venv-whisper && .venv-whisper/bin/pip install "faster-whisper" "av<14"
WHISPER_MODEL=base
WHISPER_PYTHON=python3
VOICE_MAX_SEC=600

# Spoken replies (local Piper TTS, fully offline). Point at an ONNX voice,
# e.g. https://huggingface.co/rhasspy/piper-voices (en_US-lessac-medium).
TTS_MODEL=.data/piper/en_US-lessac-medium.onnx

# Morning digest timer target chat (also accepts the chat id as argv).
DIGEST_CHAT_ID=
